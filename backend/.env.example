# --- Copy this file to .env and fill in your values ---

# Get a free key at https://finnhub.io/register  (free tier: real-time US quotes, 60 calls/min)
FINNHUB_API_KEY=your_finnhub_key_here

# Any long random string. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string

# Everyone starts with this much virtual cash
STARTING_CAPITAL=100000

# Optional: if set, new players must enter this code to register (keeps the league private)
LEAGUE_INVITE_CODE=friends2026

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# How often the background job refreshes prices for held tickers (seconds)
PRICE_REFRESH_SECONDS=60

# Hour (UTC) to snapshot everyone's portfolio value for the daily leaderboard chart (~21:00 UTC ≈ US close)
SNAPSHOT_HOUR_UTC=21
